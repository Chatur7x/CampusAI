# =============================================================
# DEPRECATED — this file is no longer a build target.
# =============================================================
# Historically `Dockerfile` built the Express backend and
# `Dockerfile.frontend` built the SPA. The two names were inverted
# relative to their contents, and this file additionally served the
# app through `vite preview` (a dev-oriented server) instead of nginx.
#
# The canonical build targets are now:
#
#   ./Dockerfile                 → frontend SPA (Vite build → nginx)
#   ./server--backend/Dockerfile → Express + Prisma backend
#   ./ai-server/Dockerfile       → FastAPI AI server
#
# This stub fails the build immediately with a readable message so a
# stale reference cannot silently produce the wrong image. The base
# image is only pulled because a Dockerfile RUN step requires a shell;
# the build never succeeds.

FROM busybox:1.37
RUN echo "ERROR: Dockerfile.frontend is deprecated and intentionally non-functional." \
    && echo "Use ./Dockerfile for the frontend, ./server--backend/Dockerfile for the backend," \
    && echo "or ./ai-server/Dockerfile for the AI server. See docs/ARCHITECTURE.md." \
    && exit 1