# =============================================================
# AISMS - Production Environment Variables
# =============================================================
# Copy this file to .env.production.local for production deployment
# NEVER commit .env files to version control

# =============================================================
# SUPABASE (Required)
# =============================================================

# Supabase Project URL
VITE_SUPABASE_URL=https://akgjpqvpcugbmdenpxny.supabase.co

# Supabase Anonymous Key (Public - safe for client)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# =============================================================
# AI SERVER (Required for ML Features)
# =============================================================

# Railway AI Server URL
VITE_AI_SERVER_URL=https://aisms-ai-server.up.railway.app

# =============================================================
# BACKEND SERVER (Optional)
# =============================================================

# Railway Backend Server URL
VITE_BACKEND_URL=https://aisms-backend.up.railway.app

# =============================================================
# APPLICATION SETTINGS
# =============================================================

# Environment
VITE_APP_ENV=production

# App Name
VITE_APP_NAME=AISMS

# App URL (for redirects, emails)
VITE_APP_URL=https://aisms.vercel.app

# Company Domain Patterns (comma-separated)
VITE_COMPANY_DOMAINS=.com,.org,.io,.co

# Educational Domain Patterns (comma-separated)
VITE_EDUCATIONAL_DOMAINS=.edu,.edu.in,.ac.in,.school,.college,university,institute,academy,iit,nit,bits

# =============================================================
# THEME SETTINGS
# =============================================================

# Default Theme (glassmorphism | neumorphism)
VITE_DEFAULT_THEME=glassmorphism

# =============================================================
# OPTIONAL FEATURES
# =============================================================

# Google Analytics
# VITE_GA_ID=G-XXXXXXXXXX

# Sentry Error Tracking
# VITE_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# =============================================================
# FEATURE FLAGS
# =============================================================

# Enable/disable features
VITE_ENABLE_FACE_RECOGNITION=true
VITE_ENABLE_REALTIME=true
VITE_ENABLE_PUSH_NOTIFICATIONS=false
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_MULTI_ORG=true
VITE_ENABLE_ANALYTICS=true

# =============================================================
# GEOLOCATION SETTINGS
# =============================================================

# Default Campus Coordinates
VITE_CAMPUS_LATITUDE=17.5
VITE_CAMPUS_LONGITUDE=78.5
VITE_MAX_ATTENDANCE_DISTANCE=500

# =============================================================
# SECURITY
# =============================================================

# Session timeout (minutes)
VITE_SESSION_TIMEOUT=30

# Enable 2FA
VITE_REQUIRE_2FA=false
