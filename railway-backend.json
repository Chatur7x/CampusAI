{
  "$schema": "https://railway.app/railway.schema.json",
  "name": "aisms-backend",
  "description": "AISMS Backend Server - REST API, Authentication, Business Logic",
  
  "build": {
    "builder": "NIXPACKS",
    "nixpacksVersion": "latest"
  },
  
  "deploy": {
    "startCommand": "npm start",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 30,
    "healthcheckInterval": 15,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1,
    "region": "us-east1"
  },
  
  "environmentVariables": {
    "NODE_ENV": "production",
    "LOG_LEVEL": "info",
    "CORS_ORIGINS": "https://aisms.vercel.app,https://aisms-frontend.vercel.app,https://ai-smart-attendance-lyart.vercel.app,https://ai-smart-attendance-1umnfemxu-chatur7xs-projects.vercel.app,http://localhost:5173"
  },
  
  "domains": [
    {
      "name": "aisms-backend.up.railway.app",
      "type": "default"
    }
  ],
  
  "metrics": {
    "enabled": true,
    "port": 9090,
    "path": "/metrics"
  }
}
