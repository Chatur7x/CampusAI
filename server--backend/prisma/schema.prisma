  security_alerts_security_alerts_user_idTousers     SecurityAlert[]             @relation("security_alerts_user_idTousers")
  security_events_security_events_resolved_byTousers SecurityEvent[]             @relation("security_events_resolved_byTousers")
  security_events_security_events_user_idTousers     SecurityEvent[]             @relation("security_events_user_idTousers")
