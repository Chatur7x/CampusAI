generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auth", "public"]
}

model Profile {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String    @unique @db.Uuid
  email          String    @unique
  role           user_role @default(STUDENT)
  first_name     String
  last_name      String
  phone          String?
  avatar_url     String?
  address        String?
  city           String?
  state          String?
  country        String?
  postal_code    String?
  date_of_birth  DateTime? @db.Date
  gender         gender?
  theme          String?   @default("dark")
  language       String?   @default("en")
  is_active      Boolean?  @default(true)
  mfa_enabled    Boolean?  @default(false)
  last_login_at  DateTime? @db.Timestamptz(6)
  login_attempts Int?      @default(0)
  lockout_until  DateTime? @db.Timestamptz(6)
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  updated_at     DateTime? @default(now()) @db.Timestamptz(6)
  users          users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([role], map: "idx_profiles_role")
  @@map("profiles")
  @@schema("public")
}

model Session {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String    @db.Uuid
  token       String    @unique
  device_info String?
  ip_address  String?   @db.Inet
  expires_at  DateTime  @db.Timestamptz(6)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  users       users     @relation("portalSessions", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("sessions")
  @@schema("public")
}

model PasswordReset {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String    @db.Uuid
  token      String    @unique
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("password_resets")
  @@schema("public")
}

model Admin {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String    @unique @db.Uuid
  permissions String[]  @default([])
  department  String?
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  users       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("admins")
  @@schema("public")
}

model Faculty {
  id                                             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                                        String           @unique @db.Uuid
  employee_id                                    String           @unique
  designation                                    String
  department_id                                  String           @db.Uuid
  joining_date                                   DateTime         @db.Date
  specialization                                 String?
  qualifications                                 String[]         @default([])
  is_active                                      Boolean?         @default(true)
  created_at                                     DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at                                     DateTime?        @default(now()) @db.Timestamptz(6)
  attendance                                     Attendance[]
  classes                                        Class[]
  departments_departments_hod_idTofaculty        Department[]     @relation("departments_hod_idTofaculty")
  departments_faculty_department_idTodepartments Department       @relation("faculty_department_idTodepartments", fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                                          users            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  leave_requests                                 LeaveRequest[]
  subjects                                       Subject[]
  timetable                                      TimetableEntry[]

  @@index([department_id], map: "idx_faculty_department")
  @@map("faculty")
  @@schema("public")
}

model Student {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id              String                @unique @db.Uuid
  enrollment_id        String                @unique
  department_id        String                @db.Uuid
  class_id             String                @db.Uuid
  batch_year           Int
  semester             Int                   @default(1)
  face_data            String?
  face_registered      Boolean?              @default(false)
  guardian_name        String?
  guardian_phone       String?
  guardian_email       String?
  is_active            Boolean?              @default(true)
  created_at           DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?             @default(now()) @db.Timestamptz(6)
  attendance           Attendance[]
  faceEmbeddings       FaceEmbedding[]
  faceVerificationLogs FaceVerificationLog[]
  grades               Grade[]
  leave_requests       LeaveRequest[]
  classes              Class                 @relation(fields: [class_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  departments          Department            @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                users                 @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([class_id], map: "idx_students_class")
  @@index([department_id], map: "idx_students_department")
  @@map("students")
  @@schema("public")
}

model Department {
  id                                         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                                       String    @unique
  code                                       String    @unique
  description                                String?
  hod_id                                     String?   @db.Uuid
  is_active                                  Boolean?  @default(true)
  created_at                                 DateTime? @default(now()) @db.Timestamptz(6)
  updated_at                                 DateTime? @default(now()) @db.Timestamptz(6)
  classes                                    Class[]
  courses                                    Course[]
  faculty_departments_hod_idTofaculty        Faculty?  @relation("departments_hod_idTofaculty", fields: [hod_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_hod")
  faculty_faculty_department_idTodepartments Faculty[] @relation("faculty_department_idTodepartments")
  students                                   Student[]

  @@map("departments")
  @@schema("public")
}

model Course {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  code          String     @unique
  credits       Int
  semester      Int
  department_id String     @db.Uuid
  description   String?
  is_active     Boolean?   @default(true)
  created_at    DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?  @default(now()) @db.Timestamptz(6)
  classes       Class[]
  departments   Department @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subjects      Subject[]

  @@map("courses")
  @@schema("public")
}

model Subject {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  code       String           @unique
  credits    Int
  course_id  String           @db.Uuid
  faculty_id String?          @db.Uuid
  is_active  Boolean?         @default(true)
  created_at DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at DateTime?        @default(now()) @db.Timestamptz(6)
  attendance Attendance[]
  grades     Grade[]
  courses    Course           @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  faculty    Faculty?         @relation(fields: [faculty_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  timetable  TimetableEntry[]

  @@map("subjects")
  @@schema("public")
}

model Class {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  section       String
  department_id String           @db.Uuid
  course_id     String           @db.Uuid
  incharge_id   String           @db.Uuid
  room_number   String?
  capacity      Int              @default(60)
  academic_year String
  is_active     Boolean?         @default(true)
  created_at    DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?        @default(now()) @db.Timestamptz(6)
  courses       Course           @relation(fields: [course_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  departments   Department       @relation(fields: [department_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  faculty       Faculty          @relation(fields: [incharge_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  students      Student[]
  timetable     TimetableEntry[]

  @@unique([name, section, academic_year])
  @@map("classes")
  @@schema("public")
}

model TimetableEntry {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId    String       @map("class_id") @db.Uuid
  subjectId  String       @map("subject_id") @db.Uuid
  facultyId  String       @map("faculty_id") @db.Uuid
  dayOfWeek  Int          @map("day_of_week")
  startTime  DateTime     @map("start_time") @db.Time(6)
  endTime    DateTime     @map("end_time") @db.Time(6)
  roomNumber String?      @map("room_number")
  isActive   Boolean?     @default(true) @map("is_active")
  created_at DateTime?    @default(now()) @db.Timestamptz(6)
  updated_at DateTime?    @default(now()) @db.Timestamptz(6)
  sessionType String?      @default("CLASS") @map("session_type")
  attendance Attendance[]
  class      Class        @relation(fields: [classId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  faculty    Faculty      @relation(fields: [facultyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subject    Subject      @relation(fields: [subjectId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([classId], map: "idx_timetable_class")
  @@index([facultyId], map: "idx_timetable_faculty")
  @@map("timetable_entries")
  @@schema("public")
}

model Attendance {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id         String            @db.Uuid
  subject_id         String?           @db.Uuid
  timetable_entry_id String?           @db.Uuid
  date               DateTime          @db.Date
  status             attendance_status
  method             attendance_method @default(MANUAL)
  confidence_score   Decimal?          @db.Decimal(5, 4)
  location           Json?
  device_info        String?
  ip_address         String?           @db.Inet
  verified_by        String?           @db.Uuid
  justification      String?
  blockchain_hash    String?
  previous_hash      String?
  nonce              Int?
  created_at         DateTime?         @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?         @default(now()) @db.Timestamptz(6)
  session_type       String?           @default("CLASS")
  students           Student           @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subjects           Subject?          @relation(fields: [subject_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  timetable_entries  TimetableEntry?   @relation(fields: [timetable_entry_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  faculty            Faculty?          @relation(fields: [verified_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([student_id, date, subject_id])
  @@index([date], map: "idx_attendance_date")
  @@index([status], map: "idx_attendance_status")
  @@index([student_id], map: "idx_attendance_student")
  @@index([student_id, date], map: "idx_attendance_student_date")
  @@map("attendance")
  @@schema("public")
}

model LeaveRequest {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id       String        @db.Uuid
  start_date       DateTime      @db.Date
  end_date         DateTime      @db.Date
  reason           String
  type             leave_type
  status           leave_status? @default(PENDING)
  documents        String[]      @default([])
  approved_by      String?       @db.Uuid
  approved_at      DateTime?     @db.Timestamptz(6)
  rejection_reason String?
  comments         String?
  created_at       DateTime?     @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?     @default(now()) @db.Timestamptz(6)
  faculty          Faculty?      @relation(fields: [approved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  students         Student       @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([status], map: "idx_leave_requests_status")
  @@index([student_id], map: "idx_leave_requests_student")
  @@map("leave_requests")
  @@schema("public")
}

model Grade {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  student_id            String    @db.Uuid
  subject_id            String    @db.Uuid
  semester              Int
  internal_marks        Decimal?  @db.Decimal(5, 2)
  external_marks        Decimal?  @db.Decimal(5, 2)
  total_marks           Decimal?  @db.Decimal(5, 2)
  grade                 String?
  grade_points          Decimal?  @db.Decimal(3, 2)
  attendance_percentage Decimal?  @db.Decimal(5, 2)
  attendance_impact     Decimal?  @default(0) @db.Decimal(5, 2)
  created_at            DateTime? @default(now()) @db.Timestamptz(6)
  updated_at            DateTime? @default(now()) @db.Timestamptz(6)
  students              Student   @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subjects              Subject   @relation(fields: [subject_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([student_id, subject_id, semester])
  @@index([student_id], map: "idx_grades_student")
  @@map("grades")
  @@schema("public")
}

model Notice {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title              String
  content            String
  priority           priority?    @default(MEDIUM)
  target_roles       user_role[]  @default([])
  target_departments String[]     @default([]) @db.Uuid
  target_classes     String[]     @default([]) @db.Uuid
  attachments        String[]     @default([])
  expiry_date        DateTime?    @db.Timestamptz(6)
  published_by       String       @db.Uuid
  read_count         Int?         @default(0)
  is_active          Boolean?     @default(true)
  is_pinned          Boolean?     @default(false)
  created_at         DateTime?    @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?    @default(now()) @db.Timestamptz(6)
  notice_reads       NoticeRead[]
  users              users        @relation(fields: [published_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([published_by], map: "idx_notices_published")
  @@map("notices")
  @@schema("public")
}

model NoticeRead {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notice_id String    @db.Uuid
  user_id   String    @db.Uuid
  read_at   DateTime? @default(now()) @db.Timestamptz(6)
  notices   Notice    @relation(fields: [notice_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users     users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([notice_id, user_id])
  @@map("notice_reads")
  @@schema("public")
}

model Notification {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String            @db.Uuid
  title      String
  message    String
  type       notification_type
  data       Json?
  action_url String?
  is_read    Boolean?          @default(false)
  read_at    DateTime?         @db.Timestamptz(6)
  created_at DateTime?         @default(now()) @db.Timestamptz(6)
  users      users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, is_read], map: "idx_notifications_user")
  @@map("notifications")
  @@schema("public")
}

model Message {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id String        @db.Uuid
  sender_id       String        @db.Uuid
  content         String
  attachments     String[]      @default([])
  is_edited       Boolean?      @default(false)
  edited_at       DateTime?     @db.Timestamptz(6)
  created_at      DateTime?     @default(now()) @db.Timestamptz(6)
  conversations   conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           users         @relation(fields: [sender_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([conversation_id, created_at(sort: Desc)], map: "idx_messages_conversation")
  @@map("messages")
  @@schema("public")
}

model AuditLog {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String?   @db.Uuid
  action      String
  entity_type String
  entity_id   String?   @db.Uuid
  old_value   Json?
  new_value   Json?
  ip_address  String?   @db.Inet
  user_agent  String?
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  users       users?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([created_at(sort: Desc)], map: "idx_audit_logs_created")
  @@index([entity_type, entity_id], map: "idx_audit_logs_entity")
  @@index([user_id], map: "idx_audit_logs_user")
  @@map("audit_logs")
  @@schema("public")
}

model Backup {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  filename       String
  size           BigInt
  type           String
  status         String
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  completed_at   DateTime? @db.Timestamptz(6)
  metadata       Json?
  retention_days Int?      @default(30)

  @@index([status, created_at(sort: Desc)], map: "idx_backups_status_created")
  @@map("backups")
  @@schema("public")
}

model SystemSetting {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String    @unique
  value       Json
  description String?
  category    String?   @default("general")
  is_public   Boolean?  @default(false)
  updated_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_by  String?   @db.Uuid
  users       users?    @relation(fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("system_settings")
  @@schema("public")
}

model BlockchainHash {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  block_index   Int       @unique
  hash          String
  previous_hash String
  data          String
  nonce         Int
  timestamp     DateTime  @db.Timestamptz(6)
  created_at    DateTime? @default(now()) @db.Timestamptz(6)

  @@map("blockchain_hashes")
  @@schema("public")
}

model SecurityAlert {
  id                                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type                                     String
  severity                                 severity
  user_id                                  String?   @db.Uuid
  description                              String
  data                                     Json?
  resolved                                 Boolean?  @default(false)
  resolved_by                              String?   @db.Uuid
  resolved_at                              DateTime? @db.Timestamptz(6)
  resolution_notes                         String?
  created_at                               DateTime? @default(now()) @db.Timestamptz(6)
  users_security_alerts_resolved_byTousers users?    @relation("security_alerts_resolved_byTousers", fields: [resolved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_security_alerts_user_idTousers     users?    @relation("security_alerts_user_idTousers", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([resolved, created_at(sort: Desc)], map: "idx_security_alerts_unresolved")
  @@map("security_alerts")
  @@schema("public")
}

model TokenBlacklist {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token_hash String   @unique
  user_id    String   @db.Uuid
  reason     String   @default("logout")
  expires_at DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expires_at], map: "idx_token_blacklist_expires")
  @@index([token_hash], map: "idx_token_blacklist_hash")
  @@map("token_blacklist")
  @@schema("public")
}

model TrustedDevice {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String    @db.Uuid
  device_hash      String
  device_name      String?
  browser          String?
  os               String?
  ip_address       String?
  last_used_at     DateTime  @default(now()) @db.Timestamptz(6)
  is_trusted       Boolean   @default(false)
  trust_expires_at DateTime? @db.Timestamptz(6)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  users            users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, device_hash])
  @@index([user_id], map: "idx_trusted_devices_user")
  @@map("trusted_devices")
  @@schema("public")
}

model LoginHistory {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String   @db.Uuid
  ip_address     String?
  user_agent     String?
  device_hash    String?
  location       Json?
  status         String
  failure_reason String?
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  users          users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([created_at], map: "idx_login_history_created")
  @@index([ip_address], map: "idx_login_history_ip")
  @@index([user_id], map: "idx_login_history_user")
  @@map("login_history")
  @@schema("public")
}

model SecurityEvent {
  id                                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_type                               String
  severity                                 String    @default("MEDIUM")
  user_id                                  String?   @db.Uuid
  ip_address                               String?
  user_agent                               String?
  description                              String
  metadata                                 Json?
  resolved                                 Boolean   @default(false)
  resolved_by                              String?   @db.Uuid
  resolved_at                              DateTime? @db.Timestamptz(6)
  created_at                               DateTime  @default(now()) @db.Timestamptz(6)
  users_security_events_resolved_byTousers users?    @relation("security_events_resolved_byTousers", fields: [resolved_by], references: [id], onUpdate: NoAction)
  users_security_events_user_idTousers     users?    @relation("security_events_user_idTousers", fields: [user_id], references: [id], onUpdate: NoAction)

  @@index([created_at], map: "idx_security_events_created")
  @@index([severity], map: "idx_security_events_severity")
  @@index([event_type], map: "idx_security_events_type")
  @@index([user_id], map: "idx_security_events_user")
  @@map("security_events")
  @@schema("public")
}

model FaceEmbedding {
  id              String    @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  studentId       String    @map("student_id") @db.Uuid
  embeddingVector Json      @map("embedding_vector")
  confidence      Float?    @default(1.0)
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  student         Student   @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([studentId], map: "idx_face_embeddings_student_id")
  @@map("face_embeddings")
  @@schema("public")
}

model FaceVerificationLog {
  id              String    @id @default(dbgenerated("extensions.uuid_generate_v4()")) @db.Uuid
  studentId       String?   @map("student_id") @db.Uuid
