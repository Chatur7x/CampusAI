# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campusai?schema=public"

# JWT
JWT_SECRET="campus-ai-super-secret-key-2024-enterprise-grade-security"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="campus-ai-refresh-secret-key-2024"

# Server
PORT=5000
NODE_ENV=development

# Email (for OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=noreply@campusai.edu

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Blockchain
BLOCKCHAIN_DIFFICULTY=4

# AI/Face Recognition
FACE_API_MODELS_PATH=./models
FACE_CONFIDENCE_THRESHOLD=0.6

# Security
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30
SESSION_TIMEOUT_HOURS=24

# Frontend URL
FRONTEND_URL=http://localhost:5173