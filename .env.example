# =============================================================
# CAMPUSAI - ENVIRONMENT VARIABLES
# =============================================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# =============================================================
# SUPABASE CONFIGURATION
# Get these from https://supabase.com/dashboard/project/_/settings/api
# =============================================================

# Supabase Project URL
VITE_SUPABASE_URL=https://akgjpqvpcugbmdenpxny.supabase.co

# Supabase Anonymous/Public Key (safe for client-side)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# AI Server URL (FastAPI server for face recognition, analytics, etc.)
VITE_AI_SERVER_URL=http://localhost:8000

# Supabase Service Role Key (NEVER expose to client - server--backend/edge functions only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# =============================================================
# APPLICATION SETTINGS
# =============================================================

# Enable demo mode (for development without Supabase)
VITE_DEMO_MODE=false

# Application environment
VITE_APP_ENV=development

# Base URL for the application
VITE_APP_URL=http://localhost:5173

# =============================================================
# AUTHENTICATION
# =============================================================

# JWT Secret (used for custom token generation if needed)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars

# JWT Refresh Secret (separate from access token secret)
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production-min-32-chars

# JWT token expiry (default: 7d)
JWT_EXPIRES_IN=7d

# Session duration in seconds (default: 7 days)
VITE_SESSION_DURATION=604800

# Enable magic link authentication
VITE_ENABLE_MAGIC_LINK=true

# Enable OAuth providers
# GitHub OAuth is recommended - configure in Supabase Dashboard > Authentication > Providers
VITE_ENABLE_GOOGLE_AUTH=false
VITE_ENABLE_GITHUB_AUTH=true
VITE_ENABLE_MICROSOFT_AUTH=false

# GitHub OAuth configured for: Chatur7x
# Set up callback URL: https://your-project.supabase.co/auth/v1/callback

# =============================================================
# EMAIL SERVICE (for Edge Functions)
# =============================================================

# Email provider (sendgrid, resend, postmark, smtp)
EMAIL_PROVIDER=sendgrid

# SendGrid API Key
SENDGRID_API_KEY=your-sendgrid-api-key

# Resend API Key (alternative)
RESEND_API_KEY=your-resend-api-key

# SMTP Configuration (alternative)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password

# Email sender address
EMAIL_FROM=noreply@campusai.edu
EMAIL_FROM_NAME=CampusAI

# =============================================================
# SMS SERVICE (optional)
# =============================================================

# Twilio credentials
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+1234567890

# =============================================================
# STORAGE
# =============================================================

# Supabase Storage bucket names
VITE_STORAGE_BUCKET_AVATARS=avatars
VITE_STORAGE_BUCKET_DOCUMENTS=documents
VITE_STORAGE_BUCKET_FACE_DATA=face-data

# Maximum file upload size in MB
VITE_MAX_UPLOAD_SIZE=10

# =============================================================
# AI/ML FEATURES
# =============================================================

# Face recognition API (if using external service)
FACE_RECOGNITION_API_URL=https://api.example.com/face
FACE_RECOGNITION_API_KEY=your-api-key

# Face similarity threshold (0-1)
FACE_SIMILARITY_THRESHOLD=0.85

# =============================================================
# GEOLOCATION
# =============================================================

# Maximum distance from campus for valid attendance (in meters)
VITE_MAX_ATTENDANCE_DISTANCE=500

# Campus coordinates (for geofencing)
VITE_CAMPUS_LATITUDE=12.9716
VITE_CAMPUS_LONGITUDE=77.5946

# =============================================================
# ANALYTICS
# =============================================================

# Google Analytics ID
VITE_GA_ID=G-XXXXXXXXXX

# PostHog API Key
VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxx
VITE_POSTHOG_HOST=https://app.posthog.com

# =============================================================
# ERROR TRACKING
# =============================================================

# Sentry DSN
VITE_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# =============================================================
# FEATURE FLAGS
# =============================================================

# Enable blockchain attendance verification
VITE_ENABLE_BLOCKCHAIN=true

# Enable AI face recognition
VITE_ENABLE_FACE_RECOGNITION=true

# Enable real-time notifications
VITE_ENABLE_REALTIME=true

# Enable push notifications
VITE_ENABLE_PUSH_NOTIFICATIONS=false

# Enable dark mode
VITE_ENABLE_DARK_MODE=true

# =============================================================
# RATE LIMITING (Edge Functions)
# =============================================================

# Max requests per minute per IP
RATE_LIMIT_MAX=100

# Rate limit window in seconds
RATE_LIMIT_WINDOW=60

# =============================================================
# DEVELOPMENT
# =============================================================

# Enable debug logging
VITE_DEBUG=false

# =============================================================
# BACKEND SERVER (server--backend)
# =============================================================

# Prisma database URL (Supabase Postgres connection string)
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Frontend URL (for CORS and email links)
FRONTEND_URL=http://localhost:5173

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Blockchain salt (change to a unique random value)
BLOCKCHAIN_SALT=your-unique-blockchain-salt

# Blockchain difficulty (default: 4)
BLOCKCHAIN_DIFFICULTY=4

# Bcrypt rounds (default: 12, minimum: 10)
BCRYPT_ROUNDS=12

# Face verification endpoint (external AI service URL)
FACE_VERIFICATION_ENDPOINT=http://localhost:8000/api/verify-face

# Face verification API key
FACE_VERIFICATION_API_KEY=

# Face confidence threshold (0-1)
FACE_CONFIDENCE_THRESHOLD=0.6

# Enable React Query DevTools
VITE_ENABLE_DEVTOOLS=true

# Mock data delay in ms (for realistic loading simulation)
VITE_MOCK_DELAY=1000
