# =============================================================
# AISMS — ENVIRONMENT VARIABLES
# =============================================================
# Copy to `.env` and fill in real values:
#   cp .env.example .env
#
# This file documents ONLY variables that are actually read by code
# today. It was generated by grepping:
#   * process.env.X            in server--backend/src/**
#   * import.meta.env.VITE_X   in src--frontend/**
#   * os.getenv("X")           in ai-server/**/*.py
#
# Service → variable ownership is marked per section:
#   [FE]    frontend  (src--frontend)  — inlined by Vite at BUILD time
#   [BE]    backend   (server--backend)
#   [AI]    AI server (ai-server)
#   [ALL]   read by more than one service
#
# ─────────────────────────────────────────────────────────────────
# SECURITY RULES
# ─────────────────────────────────────────────────────────────────
#   1. Never commit a filled-in copy of this file. `.env` is in
#      .gitignore and in every .dockerignore, so it cannot reach an
#      image layer — keep it that way.
#   2. Any variable marked SECRET below must never be prefixed with
#      VITE_. Vite inlines every VITE_* value into the JavaScript
#      bundle, so a `VITE_`-prefixed secret is published to the
#      internet. (Note: a `VITE_SUPABASE_SERVICE_ROLE_KEY` exists in
#      some local .env files. It is NOT read by the frontend source —
#      delete it, it is a service-role key with full database
#      bypass and has no business in a browser bundle.)
#   3. Generate secrets, do not invent them by hand:
#        node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#   4. VITE_* values are baked into the frontend bundle at build
#      time. Changing one requires a REBUILD, not a restart.
# =============================================================


# =============================================================
# SUPABASE  [ALL]
# =============================================================
# Supabase project API settings:
#   Dashboard → Project Settings → API
# Note the asymmetry: the frontend needs the ANON key; both server
# services need the SERVICE key. They are different credentials.

# [FE][AI] Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# [FE] Supabase anon/public key. Safe to ship in the browser bundle
# ONLY because row-level security in Postgres is the real boundary.
# Replace the whole line with the value from the dashboard.
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# [AI] Service-role key. BYPASSES row-level security. Server-side
# only. Never expose this to a browser.
#
# NAMING TRAP: ai-server/config.py reads SUPABASE_SERVICE_KEY, but the
# committed .env and older docs use SUPABASE_SERVICE_ROLE_KEY. They are
# NOT interchangeable names and there is no aliasing in the code — if
# you only set SUPABASE_SERVICE_ROLE_KEY, the AI server logs
# "Missing required env vars: SUPABASE_SERVICE_KEY" at startup and
# falls back to an anonymous Supabase client. Set SUPABASE_SERVICE_KEY.
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# [AI] Anon key, for the AI server's own Supabase client. Defaults
# in code to None; set it so the AI server can do RLS-scoped reads.
SUPABASE_ANON_KEY=your-supabase-anon-key


# =============================================================
# FRONTEND  [FE]  — Vite inlines these at BUILD time
# =============================================================

# Base URL of the FastAPI AI server, as reachable from the BROWSER.
# Local dev / docker compose: http://localhost:8000
VITE_AI_SERVER_URL=http://localhost:8000

# Base URL of the Express backend, as reachable from the BROWSER.
# Local dev / docker compose: http://localhost:5000
VITE_BACKEND_URL=http://localhost:5000

# Maximum distance (metres) from campus for a geofence to pass.
VITE_MAX_ATTENDANCE_DISTANCE=500

# Campus reference point used by the client-side geo check.
# Keep in sync with CAMPUS_LAT / CAMPUS_LON below.
VITE_CAMPUS_LATITUDE=17.335
VITE_CAMPUS_LONGITUDE=78.714


# =============================================================
# BACKEND — core  [BE]
# =============================================================
# server--backend/src/config/env.ts throws at startup if any of
# DATABASE_URL, JWT_SECRET, JWT_REFRESH_SECRET, SMTP_HOST, SMTP_USER,
# SMTP_PASS or FRONTEND_URL is missing. All of them are REQUIRED.

# Postgres connection string used by Prisma. Supabase → Project
# Settings → Database → Connection string → URI (use the *session*
# pooler, port 5432, for a long-lived server, not the transaction
# pooler on 6543).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# SECRET — signing key for access tokens. >= 32 random characters.
JWT_SECRET=replace-with-48-random-bytes-base64url

# SECRET — signing key for refresh tokens. Must DIFFER from
# JWT_SECRET, so that a leaked refresh key does not also let an
# attacker mint access tokens.
JWT_REFRESH_SECRET=replace-with-48-different-random-bytes-base64url

# Access-token lifetime. Accepts any `ms`-library duration string.
JWT_EXPIRES_IN=7d

# Public origin of the SPA. Used for CORS and links inside emails.
FRONTEND_URL=http://localhost:5173

# Comma-separated list of allowed browser origins.
# ai-server reads the SAME variable name, so keep them in sync.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Port the Express server binds to.
PORT=5000

# Node runtime mode. `production` in every deployed environment.
NODE_ENV=development


# =============================================================
# BACKEND — email (SMTP)  [BE]
# =============================================================
# SMTP_HOST, SMTP_USER and SMTP_PASS are REQUIRED by env.ts.

SMTP_HOST=smtp.example.com
SMTP_PORT=587

# "true" for implicit TLS (usually port 465). Must be the exact
# string "true" — anything else is treated as false.
SMTP_SECURE=false

SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# Envelope sender for outgoing mail.
FROM_EMAIL=no-reply@example.com


# =============================================================
# BACKEND — face verification handoff  [BE]
# =============================================================
# The backend does not do face recognition itself; it forwards a
# verification request to the FastAPI AI server and decides on the
# result. Keep this pointing at the AI server.

# Internal (docker network) address in docker compose.
FACE_VERIFICATION_ENDPOINT=http://ai-server:8000/api/face/verify

# Optional shared secret presented to the AI server. Unset by
# default; set it if the AI server is reachable from outside its
# network.
FACE_VERIFICATION_API_KEY=

# Minimum similarity the backend will accept as a match (0-1).
FACE_CONFIDENCE_THRESHOLD=0.6


# =============================================================
# BACKEND — security tunables  [BE]
# =============================================================

# SECRET — salt mixed into the attendance record hashes. Changing it
# invalidates every previously signed record, so set it once and keep
# it stable. The code refuses the literal default "change-me" in
# spirit (it warns); never deploy with the default.
BLOCKCHAIN_SALT=replace-with-a-long-random-salt

# Proof-of-work difficulty for the attendance ledger.
BLOCKCHAIN_DIFFICULTY=4

# bcrypt cost factor. Higher is slower and safer; 12 is the default
# and the code floors it at 10.
BCRYPT_ROUNDS=12

# Directory for CSV bulk-upload files, relative to the process cwd.
# In Docker the image sets this to /app/uploads (a volume).
UPLOAD_PATH=./uploads

# Maximum accepted upload size in BYTES. Default 10485760 = 10 MiB.
MAX_FILE_SIZE=10485760


# =============================================================
# AI SERVER — network  [AI]
# =============================================================

# Bind address. Must be 0.0.0.0 inside a container.
AI_SERVER_HOST=0.0.0.0

# Bind port. PORT wins over this when both are set (see config.py),
# because platforms such as Railway inject PORT.
AI_SERVER_PORT=8000

# Number of uvicorn workers. Each worker loads its own copy of the
# InsightFace model, so raise this only with memory headroom.
WORKERS=1


# =============================================================
# AI SERVER — geofencing  [AI]
# =============================================================
# Keep these consistent with VITE_CAMPUS_LATITUDE / LONGITUDE above;
# the server is authoritative, the client value is only a pre-check.

CAMPUS_LAT=17.335
CAMPUS_LON=78.714

# Radius in metres.
CAMPUS_RADIUS_M=500


# =============================================================
# AI SERVER — face recognition and liveness  [AI]
# =============================================================

# Face embedding backend: `insightface` or `deepface`.
FACE_BACKEND=insightface

# Cosine-similarity floor for a face match (0-1). Lower = stricter.
# Distinct from the backend's FACE_CONFIDENCE_THRESHOLD, which is the
# gate applied to the AI server's answer.
FACE_SIMILARITY_THRESHOLD=0.55

# Use a GPU runtime when one is present.
GPU_ENABLED=false

# Require the blink challenge during check-in.
LIVENESS_CHALLENGE_ENABLED=true

# Run the deepfake screen on the submitted frame.
DEEPFAKE_DETECTION_ENABLED=true

# Eye-aspect-ratio below this counts as a blink.
EAR_BLINK_THRESHOLD=0.22

# Head yaw in degrees required to pass the head-turn challenge.
HEAD_TURN_THRESHOLD=15


# =============================================================
# AI SERVER — confidence scoring and fraud  [AI]
# =============================================================
# The four CONF_WEIGHT_* values should sum to 1.0.

# Weight of the face-similarity component.
CONF_WEIGHT_FACE=0.50

# Weight of the liveness component.
CONF_WEIGHT_LIVENESS=0.20

# Weight of the geofence component.
CONF_WEIGHT_GEO=0.15

# Weight of the device-trust component.
CONF_WEIGHT_DEVICE=0.15

# Expected contamination rate for the fraud/anomaly model.
FRAUD_CONTAMINATION=0.05


# =============================================================
# AI SERVER — observability  [AI]
# =============================================================

# Write the on-disk audit trail.
AUDIT_LOG_ENABLED=true

# Directory for audit records.
AUDIT_LOG_DIR=./audit_logs

# MLflow tracking URI. The server degrades gracefully when mlflow is
# not installed.
MLFLOW_TRACKING_URI=./mlruns


# =============================================================
# NOT READ BY ANY SERVICE — do not add these back
# =============================================================
# The following appeared in an earlier version of this file but are
# referenced nowhere in the current source. They are listed here only
# so a reviewer does not "restore" them:
#
#   VITE_DEMO_MODE, VITE_APP_ENV, VITE_APP_URL, VITE_APP_NAME,
#   VITE_SESSION_DURATION, VITE_ENABLE_MAGIC_LINK,
#   VITE_ENABLE_GOOGLE_AUTH, VITE_ENABLE_GITHUB_AUTH,
#   VITE_ENABLE_MICROSOFT_AUTH, VITE_COMPANY_DOMAINS,
#   VITE_STORAGE_BUCKET_*, VITE_MAX_UPLOAD_SIZE, VITE_GA_ID,
#   VITE_POSTHOG_KEY, VITE_POSTHOG_HOST, VITE_SENTRY_DSN,
#   VITE_ENABLE_*, VITE_DEBUG, VITE_ENABLE_DEVTOOLS, VITE_MOCK_DELAY,
#   SUPABASE_SERVICE_ROLE_KEY, EMAIL_PROVIDER, SENDGRID_API_KEY,
#   RESEND_API_KEY, EMAIL_FROM, EMAIL_FROM_NAME, TWILIO_*,
#   FACE_RECOGNITION_API_URL, FACE_RECOGNITION_API_KEY,
#   RATE_LIMIT_MAX, RATE_LIMIT_WINDOW, ENVIRONMENT, LOG_LEVEL,
#   PYTHONUNBUFFERED, FASTAPI_RELOAD, TIMEOUT
#
# Some of these are still set by railway.json / vercel.json (those
# files are platform config, not service config). If a variable is
# genuinely needed, add the read call in code FIRST, then document it
# here.
# =============================================================